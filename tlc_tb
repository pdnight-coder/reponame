`timescale 1ns / 1ps
module tb_traffic_light_controller;

reg clk;
reg reset;
reg farm_car;
// Outputs
wire R1;
wire Y1;
wire G1;
wire R2;
wire Y2;
wire G2;
traffic_light_controller #(
.CLK_FREQ(1)
) DUT (
.clk(clk),
.reset(reset),
.farm_car(farm_car),
.R1(R1),
.Y1(Y1),
.G1(G1),
.R2(R2),
.Y2(Y2),
.G2(G2)
);
initial
begin
clk = 0;
forever
begin
#5 clk = ~clk;
end
end
initial
begin
// Initial condition
reset = 1;
farm_car = 0;
// Apply reset for 20 ns
#20;
// Remove reset
reset = 0;
// Run simulation
#800;
// Change farm car detector
farm_car = 1;
#200;
farm_car = 0;
#300;
$finish;
end
end
endmodule
